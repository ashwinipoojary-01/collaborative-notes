# Copy to backend/.env and fill in real values. Never commit the real .env file.

# --- Backend ---
PORT=5000
# Local MongoDB:      mongodb://127.0.0.1:27017/collaborative-notes
# MongoDB Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/collaborative-notes?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/collaborative-notes
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins (CORS + Socket.IO)
CLIENT_ORIGIN=http://localhost:5173
# Max login/register attempts per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=20
# Set to true to serve frontend/dist from the API server (single-port production deploy)
SERVE_FRONTEND=false

# --- Frontend (optional, frontend/.env) ---
# Only needed when the API is on a different origin than the frontend (no Vite proxy / reverse proxy).
# VITE_API_URL=https://api.example.com
# VITE_SOCKET_URL=https://api.example.com
